# ============================================================
# CRITICAL: Data files needed for the app to work
# These MUST be tracked in git so Render can deploy them
# ============================================================

# 1. Ignore everything in backend/data by default to keep the repo clean
backend/data/*
backend-backup-*/
repair-review-*/

# 2. EXCEPT the core folders and files we explicitly want
!backend/data/
!backend/data/chunks/
!backend/data/chunks/*.json
!backend/data/live_hotels.json

# 3. Allow the legacy backend code to be pushed
!backend/legacy/
!backend/legacy/*.js
